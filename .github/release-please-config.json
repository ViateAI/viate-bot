{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "extra-files": [
        { "type": "json", "path": "apps/control/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/e2e/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/machined/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/browser/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/integration-viate/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/protocol/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
