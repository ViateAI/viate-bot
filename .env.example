VB_PUBLIC_URL=http://127.0.0.1:3000
VB_OIDC_ISSUER=
VB_OIDC_CLIENT_ID=
VB_OIDC_CLIENT_SECRET=
# 仅允许创建登录用户，不自动开通 bot；开通完成前不能读取或操作临时 bot，也不能运行任务。
VB_ALLOW_SIGNUP=false
# 身份提供方的账号由管理员统一创建时（例如 viate）设为 true，把给出的邮箱当作已验证。
VB_OIDC_TRUST_EMAIL=false
VB_MODEL_BASE_URL=
VB_MODEL_API_KEY=
# openai-completions（默认，工具和流式用量兼容面最广）或 openai-responses。
VB_MODEL_API=openai-completions
# 逗号分隔。留空表示不额外限制模型。内置模板不预设模型。
# 管理员开通时依次使用请求模型、模板默认模型、此列表第一个；都为空则拒绝开通。
VB_MODELS=
VB_MODEL_MAX_TOKENS=4096
VB_MODEL_CONTEXT_TOKENS=256000
# 上下文摘要的输出上限。对话超过上下文窗口的 60% 时，经模型网关生成摘要。
VB_SUMMARY_MAX_TOKENS=2000
VB_TASK_TOKEN_BUDGET=2000000
VB_MODEL_RATE_USER=120
VB_MODEL_RATE_BOT=60
VB_MAX_TASK_STEPS=200
VB_MAX_TASK_DURATION_SEC=3600
# 管理员开通时的默认配额；缺少 quotas 行不使用这些默认值授予用户权限。
VB_DEFAULT_MAX_BOTS=5
VB_DEFAULT_MAX_CONCURRENT_TASKS=2
VB_DEFAULT_MAX_ROUTINES=10
VB_INTEGRATION=none
# 下面三项只在 VB_INTEGRATION=viate 时读取。缺了不会阻止控制面启动，用到服务接口时才报错。
VB_VIATE_URL=
VB_VIATE_CLIENT_ID=
VB_VIATE_CLIENT_SECRET=
VB_ADMIN_EMAILS=
VB_DATA_DIR=./data
VB_UPLOAD_STORAGE=local
# 下面几项只在 VB_UPLOAD_STORAGE=s3 时读取。桶和区域必填。
# 访问密钥留空则使用 SDK 默认凭据链；只填一个会启动失败。不要把真实密钥写进仓库。
VB_S3_BUCKET=
VB_S3_REGION=
VB_S3_ENDPOINT=
# 只有 1 开启 path-style。对象键是 <前缀>/uploads/<用户 id>/<上传 id>，不含原始文件名。
VB_S3_FORCE_PATH_STYLE=
VB_S3_PREFIX=
VB_S3_ACCESS_KEY_ID=
VB_S3_SECRET_ACCESS_KEY=
# 已有附件时切换 VB_UPLOAD_STORAGE，必须设为 1 才能启动。旧文件不迁移、不删除，聊天里不能再预览、下载或发送。
VB_UPLOAD_STORAGE_ACCEPT_SWITCH=
VB_MACHINE_IMAGE=viate-bot/machine:dev
VB_IDLE_STOP_MINUTES=120
VB_MAX_RUNNING_TASKS=20
# /metrics 的 Bearer token。留空则拒绝所有抓取，不要把空 token 当成开放。
VB_METRICS_TOKEN=
# 逗号分隔。这些模型才会看到 browser_screenshot，空则不注册该工具。
VB_VISION_MODELS=
# request_secret 等待用户输入的毫秒数，缺省 30 分钟。超时后任务失败。
VB_SECRET_WAIT_MS=1800000
VB_CONTROL_PORT=3000
VB_DEV=1
