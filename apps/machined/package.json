{
  "name": "@viate-bot/machined",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && node ../../node_modules/typescript/bin/tsc -p ../../packages/browser/tsconfig.build.json && tsc -p tsconfig.probe.json --noEmit",
    "test": "vitest run",
    "image": "node image.mjs",
    "browser-probe": "tsx scripts/browser-probe.ts"
  },
  "dependencies": {
    "@viate-bot/browser": "workspace:*",
    "@viate-bot/protocol": "workspace:*",
    "fastify": "^5.6.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
